{
  "name": "enforce-disable-public-network-access",
  "properties": {
    "displayName": "Enforce Private-Only Access (Disable Public Network Access) with Platform Managed RG Bypass",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Denies public network access across all major PaaS services (Storage, Key Vault, ACR, SQL, Synapse, Cosmos DB, OpenAI/Cognitive Services, AI Search, Service Bus, Event Hubs, Event Grid, Data Factory, App Services, PostgreSQL, MySQL, Redis, Automation, Machine Learning, SignalR, IoT Hub, Batch, App Configuration) while exempting Azure first-party managed resource groups and automated platform provisioning.",
    "metadata": {
      "category": "Network",
      "version": "3.0.1"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Policy Effect",
          "description": "Effect of the policy (Deny, Audit, or Disabled)."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "excludedResourceGroupPatterns": {
        "type": "Array",
        "metadata": {
          "displayName": "Excluded Resource Group Name Patterns",
          "description": "List of resource group wildcard patterns to exempt from denial. Note: Each pattern must contain at most one wildcard (*) character."
        },
        "defaultValue": [
          "MC_*",
          "databricks-rg-*",
          "cloud-shell-storage-*",
          "AzureBackupRG_*",
          "NetworkWatcherRG*",
          "synapse-*",
          "synapseworkspace-*",
          "ASR-*",
          "asr-*",
          "azure-spring-cloud-*"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "anyOf": [
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Storage/storageAccounts"
                  },
                  {
                    "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.KeyVault/vaults"
                  },
                  {
                    "field": "Microsoft.KeyVault/vaults/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.ContainerRegistry/registries"
                  },
                  {
                    "field": "Microsoft.ContainerRegistry/registries/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Sql/servers"
                  },
                  {
                    "field": "Microsoft.Sql/servers/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Synapse/workspaces"
                  },
                  {
                    "field": "Microsoft.Synapse/workspaces/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.DocumentDB/databaseAccounts"
                  },
                  {
                    "field": "Microsoft.DocumentDB/databaseAccounts/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.CognitiveServices/accounts"
                  },
                  {
                    "field": "Microsoft.CognitiveServices/accounts/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Search/searchServices"
                  },
                  {
                    "field": "Microsoft.Search/searchServices/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.ServiceBus/namespaces"
                  },
                  {
                    "field": "Microsoft.ServiceBus/namespaces/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.EventHub/namespaces"
                  },
                  {
                    "field": "Microsoft.EventHub/namespaces/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.EventGrid/topics"
                  },
                  {
                    "field": "Microsoft.EventGrid/topics/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.EventGrid/domains"
                  },
                  {
                    "field": "Microsoft.EventGrid/domains/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.DataFactory/factories"
                  },
                  {
                    "field": "Microsoft.DataFactory/factories/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Web/sites"
                  },
                  {
                    "field": "Microsoft.Web/sites/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.DBforPostgreSQL/flexibleServers"
                  },
                  {
                    "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.DBforMySQL/flexibleServers"
                  },
                  {
                    "field": "Microsoft.DBforMySQL/flexibleServers/network.publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Cache/redis"
                  },
                  {
                    "field": "Microsoft.Cache/redis/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Automation/automationAccounts"
                  },
                  {
                    "field": "Microsoft.Automation/automationAccounts/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.MachineLearningServices/workspaces"
                  },
                  {
                    "field": "Microsoft.MachineLearningServices/workspaces/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.SignalRService/SignalR"
                  },
                  {
                    "field": "Microsoft.SignalRService/SignalR/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Devices/IotHubs"
                  },
                  {
                    "field": "Microsoft.Devices/IotHubs/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Batch/batchAccounts"
                  },
                  {
                    "field": "Microsoft.Batch/batchAccounts/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.AppConfiguration/configurationStores"
                  },
                  {
                    "field": "Microsoft.AppConfiguration/configurationStores/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              }
            ]
          },
          {
            "value": "[empty(resourceGroup().managedBy)]",
            "equals": "true"
          },
          {
            "count": {
              "value": "[parameters('excludedResourceGroupPatterns')]",
              "name": "pattern",
              "where": {
                "value": "[resourceGroup().name]",
                "like": "[current('pattern')]"
              }
            },
            "equals": 0
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
