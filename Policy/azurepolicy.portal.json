{
  "mode": "Indexed",
  "policyRule": {
    "if": {
      "allOf": [
        {
          "anyOf": [
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.Storage/storageAccounts"
                },
                {
                  "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.KeyVault/vaults"
                },
                {
                  "field": "Microsoft.KeyVault/vaults/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.ContainerRegistry/registries"
                },
                {
                  "field": "Microsoft.ContainerRegistry/registries/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.Sql/servers"
                },
                {
                  "field": "Microsoft.Sql/servers/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.Synapse/workspaces"
                },
                {
                  "field": "Microsoft.Synapse/workspaces/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.DocumentDB/databaseAccounts"
                },
                {
                  "field": "Microsoft.DocumentDB/databaseAccounts/publicNetworkAccess",
                  "notEquals": "Disabled"
                }
              ]
            }
          ]
        },
        {
          "value": "[empty(resourceGroup().managedBy)]",
          "equals": "true"
        },
        {
          "count": {
            "value": "[parameters('excludedResourceGroupPatterns')]",
            "name": "pattern",
            "where": {
              "value": "[resourceGroup().name]",
              "like": "[current('pattern')]"
            }
          },
          "equals": 0
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  },
  "parameters": {
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Policy Effect",
        "description": "Effect of the policy (Deny, Audit, or Disabled)."
      },
      "allowedValues": [
        "Audit",
        "Deny",
        "Disabled"
      ],
      "defaultValue": "Deny"
    },
    "excludedResourceGroupPatterns": {
      "type": "Array",
      "metadata": {
        "displayName": "Excluded Resource Group Name Patterns",
        "description": "List of resource group wildcard patterns to exempt from denial (e.g., AKS node pools, Databricks workspace backend, Cloud Shell)."
      },
      "defaultValue": [
        "MC_*",
        "databricks-rg-*",
        "cloud-shell-storage-*",
        "*synapse*",
        "AzureBackupRG_*"
      ]
    }
  }
}

