{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-azure-resource-summary",
      "metadata": {
        "description": "The name of the Logic App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The location of the Logic App."
      }
    },
    "teamsWebhookUrl": {
      "type": "securestring",
      "metadata": {
        "description": "The Incoming Webhook URL for the Microsoft Teams channel."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "teamsWebhookUrl": {
              "defaultValue": "[parameters('teamsWebhookUrl')]",
              "type": "SecureString"
            }
          },
          "triggers": {
            "Recurrence": {
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [
                    "18"
                  ],
                  "minutes": [
                    0
                  ]
                }
              },
              "evaluatedRecurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [
                    "18"
                  ],
                  "minutes": [
                    0
                  ]
                }
              },
              "type": "Recurrence"
            }
          },
          "actions": {
            "Query_Azure_Resource_Graph": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "authentication": {
                  "audience": "https://management.azure.com/",
                  "type": "ManagedServiceIdentity"
                },
                "body": {
                  "query": "resourcechanges | extend changeTime = todatetime(properties.changeAttributes.timestamp) | where changeTime >= startofday(now()) | summarize Created = countif(properties.changeType == 'Create'), Deleted = countif(properties.changeType == 'Delete')"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "method": "POST",
                "uri": "https://management.azure.com/providers/Microsoft.ResourceGraph/resources?api-version=2021-03-01"
              }
            },
            "Parse_JSON": {
              "runAfter": {
                "Query_Azure_Resource_Graph": [
                  "Succeeded"
                ]
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Query_Azure_Resource_Graph')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Created": {
                            "type": "integer"
                          },
                          "Deleted": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "Created",
                          "Deleted"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "Send_Teams_Message": {
              "runAfter": {
                "Parse_JSON": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "body": {
                  "text": "@{concat('Hello Team,<br><br>Here is the summary of Azure resources modified today:<br><br><b>Resources Created:</b> ', body('Parse_JSON')?['data'][0]['Created'], '<br><b>Resources Deleted:</b> ', body('Parse_JSON')?['data'][0]['Deleted'])}",
                  "title": "Daily Azure Resource Summary"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "method": "POST",
                "uri": "@parameters('teamsWebhookUrl')"
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ]
}
